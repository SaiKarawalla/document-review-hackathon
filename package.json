{
  "name": "document-review-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start": "tsx server/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
