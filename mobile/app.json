{
  "expo": {
    "name": "Document Review",
    "slug": "document-review-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "document-review",
    "plugins": [
      "expo-router",
      ["expo-image-picker", {"cameraPermission":"Take a document photo for local review.","photosPermission":"Choose a document photo for local review.","microphonePermission":false}],
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "enableOpenCLAndHexagon": false
        }
      ],
      "expo-build-properties",
      "./plugins/withPhoneModel"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.documentreview.hackathon",
      "infoPlist": {}
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
